# Defina uma chave para o agente Mastra usar a OpenAI.
OPENAI_API_KEY=
MASTRA_MODEL=openai/gpt-6-luna
# true ativa um modo local determinístico, indicado na interface.
DEMO_MODE=false
# Arquivo local (padrão) ou URL libSQL remota do Turso (libsql://...).
DATABASE_URL=./data/nexo.sqlite
# Só para banco remoto. Em produção, use as variáveis do ambiente, nunca o Git.
DATABASE_AUTH_TOKEN=
# Tetos de uso por 24 h para proteger a chave do modelo (por usuário e total).
DAILY_MESSAGE_LIMIT=100
GLOBAL_DAILY_MESSAGE_LIMIT=1000
# Probabilidade 0..1 de indisponibilidade temporária do legado simulado.
LEGACY_FAILURE_RATE=0
LEGACY_DELAY_MS=0
